{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "academik",
  "version": "0.3.12",
  "identifier": "app.academik.learn",
  "build": { "frontendDist": "../dist", "beforeBuildCommand": "npm run build" },
  "app": {
    "windows": [{ "label": "main", "title": "academik", "width": 1100, "height": 760, "minWidth": 360, "minHeight": 520 }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://raantss18.github.io; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'" }
  },
  "bundle": { "active": true, "targets": ["appimage"], "category": "Education", "shortDescription": "academik", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"], "linux": { "appimage": { "bundleMediaFramework": false } } }
}
