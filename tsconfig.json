{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "bundler", "strict": true, "skipLibCheck": true,
    "verbatimModuleSyntax": true, "isolatedModules": true, "types": ["svelte", "vite/client", "node"], "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts"]
}
